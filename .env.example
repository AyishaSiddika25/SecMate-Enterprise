# Required for DeepTeam's attack simulator and evaluator.
# Copy this file to .env or set the variable in your shell. Never commit real keys.
OPENAI_API_KEY=

# Optional: use a real HTTP target instead of the explicitly simulated SecMate demo target.
# Only exact HTTPS hostnames in this comma-separated allowlist can be entered in the UI.
DEEPTEAM_ALLOWED_TARGET_HOSTS=your-authorized-test-target.example
DEEPTEAM_TARGET_URL=https://your-authorized-test-target.example/api/chat
DEEPTEAM_TARGET_BEARER_TOKEN=
DEEPTEAM_TARGET_INPUT_FIELD=input
DEEPTEAM_TARGET_OUTPUT_FIELD=output
DEEPTEAM_TARGET_TIMEOUT_SECONDS=30
